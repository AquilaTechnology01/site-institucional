# HTML e recursos de controle sempre revalidam a versão publicada.
/
  Cache-Control: no-cache, max-age=0, must-revalidate
/*.html
  Cache-Control: no-cache, max-age=0, must-revalidate
/portfolio/
  Cache-Control: no-cache, max-age=0, must-revalidate
/styles.css
  Cache-Control: no-cache, max-age=0, must-revalidate
/src/*.css
  Cache-Control: no-cache, max-age=0, must-revalidate
/src/js/*
  Cache-Control: no-cache, max-age=0, must-revalidate
/src/data/*
  Cache-Control: no-cache, max-age=0, must-revalidate

# Somente bundles com conteúdo identificado por hash usam cache imutável.
/assets/runtime/*
  Cache-Control: public, max-age=31536000, immutable
